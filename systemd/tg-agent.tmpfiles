# systemd creates these, because the service runs as a user that exists only while it runs,
# and a directory it created would carry a meaningless owner. Both sit outside
# /var/lib/tg-agent, the StateDirectory systemd hands to that user whole: permissions
# there would become writable by the service, and the outbox unwritable
d /etc/tg-agent 0700 root root -
d /var/lib/tg-agent-permissions 0755 root root -
d /var/lib/tg-agent-permissions/chats 0755 root root -
d /var/lib/tg-agent-permissions/folders 0755 root root -
d /var/lib/tg-agent-outbox 2775 root users -
